@startuml
left to right direction

actor "Organisation User" as User

rectangle "Population Reporting System" {
    package "Country Reports" {
        usecase "UC1: All countries worldwide" as UC1
        usecase "UC2: Countries by continent" as UC2
        usecase "UC3: Countries by region" as UC3
        usecase "UC4: Top N countries worldwide" as UC4
        usecase "UC5: Top N countries by continent" as UC5
        usecase "UC6: Top N countries by region" as UC6
    }

    package "City Reports" {
        usecase "UC7: All cities worldwide" as UC7
        usecase "UC8: Cities by continent" as UC8
        usecase "UC9: Cities by region" as UC9
        usecase "UC10: Cities by country" as UC10
        usecase "UC11: Cities by district" as UC11
        usecase "UC12: Top N cities worldwide" as UC12
        usecase "UC13: Top N cities by continent" as UC13
        usecase "UC14: Top N cities by region" as UC14
        usecase "UC15: Top N cities by country" as UC15
        usecase "UC16: Top N cities by district" as UC16
    }

    package "Capital City Reports" {
        usecase "UC17: All capitals worldwide" as UC17
        usecase "UC18: Capitals by continent" as UC18
        usecase "UC19: Capitals by region" as UC19
        usecase "UC20: Top N capitals worldwide" as UC20
        usecase "UC21: Top N capitals by continent" as UC21
        usecase "UC22: Top N capitals by region" as UC22
    }

    package "Population Breakdown Reports" {
        usecase "UC23: Population breakdown\nby continent" as UC23
        usecase "UC24: Population breakdown\nby region" as UC24
        usecase "UC25: Population breakdown\nby country" as UC25
    }

    package "Population Totals" {
        usecase "UC26: World population" as UC26
        usecase "UC27: Continent population" as UC27
        usecase "UC28: Region population" as UC28
        usecase "UC29: Country population" as UC29
        usecase "UC30: District population" as UC30
        usecase "UC31: City population" as UC31
    }

    package "Language Report" {
        usecase "UC32: Language populations\nand world percentages" as UC32
    }
}

